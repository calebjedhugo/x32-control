{
  "sandbox": {
    "enabled": false
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/session_capture.py *)",
      "Bash(python scripts/control.py *)",
      "Bash(python scripts/rta_listen.py *)",
      "Bash(python scripts/analyze.py *)",
      "Bash(python scripts/diff_sessions.py *)",
      "Bash(python scripts/query.py *)",
      "Bash(python scripts/extract.py *)",
      "Bash(python scripts/splice_rta.py *)",
      "Bash(python scripts/update_peaks.py *)",
      "Bash(python scripts/poll_file.py *)",
      "Bash(python scripts/capture.py *)",
      "Bash(python scripts/snapshot.py *)",
      "Bash(cd *x32-control* && source venv/bin/activate && python scripts/*)",
      "Bash(rm -f /tmp/rta_*)",
      "Bash(rm -f /tmp/mix_changes*)",
      "Bash(rm -f /tmp/metering_changes*)",
      "Bash(rm -f /tmp/eq_changes*)",
      "Bash(rm -f /tmp/upstream_changes*)",
      "Bash(cp /tmp/rta_*)",
      "Bash(cp /tmp/rta_batch_*.jsonl /tmp/rta_batch_*.jsonl)",
      "Bash(touch /tmp/rta_*)",
      "Bash(cat /tmp/rta_*)",
      "Bash(cat /tmp/rta_batch_*.jsonl >> /tmp/rta_batch_*.jsonl)",
      "Bash(TIMEOUT=*)",
      "Write(//tmp/mix_changes*)",
      "Write(//tmp/metering_changes*)",
      "Write(//tmp/eq_changes*)",
      "Write(//tmp/upstream_changes*)",
      "Write(//tmp/agent_prompt_*)",
      "Write(//tmp/agent_output_*)",
      "Bash(claude -p --model * --output-format text < /tmp/agent_prompt_*)",
      "Bash(claude -p --output-format text < /tmp/agent_prompt_*)",
      "Bash(rm -f /tmp/agent_prompt_*)",
      "Bash(rm -f /tmp/agent_output_*)",
      "Write(/captures/*)",
      "Edit(/captures/*)",
      "Edit(/docs/CORRECTIONS.md)"
    ]
  }
}
